                <mxCell id="17" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="13">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="580" y="380" as="sourcePoint"/>
                        <mxPoint x="630" y="330" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="18" value="" style="endArrow=classic;html=1;" edge="1" parent="1" target="13">
                    <mxGeometry width="50" height="50" relative="1" as="geometry">
                        <mxPoint x="580" y="380" as="sourcePoint"/>
                        <mxPoint x="630" y="330" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="13" value="&lt;p data-path-to-node=&quot;10,2,0&quot;&gt;Build an action directly on the Chicken Tracker page called &quot;Create Item Journal Lines&quot;.&lt;/p&gt;&lt;p data-path-to-node=&quot;10,2,0&quot;&gt;When the user clicks it, a processing Codeunit runs.&lt;/p&gt;&lt;p data-path-to-node=&quot;10,2,0&quot;&gt;It grabs all un-processed records for the selected date.&lt;/p&gt;&lt;p data-path-to-node=&quot;10,2,0&quot;&gt;It automatically inserts standard Item Journal Line records mapping your custom data to standard fields (e.g., Item No. = &#39;EGGS&#39;, Quantity = Tracker.Eggs Qty, Posting Date = Tracker.Date).&lt;/p&gt;&lt;p data-path-to-node=&quot;10,2,0&quot;&gt;This keeps standard BC objects clean and reduces the number of custom fields you need to maintain.&lt;/p&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
                    <mxGeometry x="590" y="290" width="260" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Summary of whole Solution&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Data Entry: Daily entry populates the Chicken Tracker (either manually or via API from the camera)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Action: User clicks &quot;Create Journal Lines&quot; on the Tracker page.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Codeunit Execution: AL code validates the un-processed entries, generates standard Item Journal Lines (Positive Adjustment), and leaves them ready for review.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Posting: User reviews the Item Journal and clicks Post.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Event Subscriber (The Hook): An event subscriber listens for the successful posting of those specific journal lines and updates the original Chicken Tracker records to Processed = true.&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="220" y="410" width="360" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="" style="edgeStyle=segmentEdgeStyle;endArrow=classic;html=1;curved=0;rounded=0;endSize=8;startSize=8;" edge="1" parent="1">
